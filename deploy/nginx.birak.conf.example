# Example nginx reverse-proxy config for Birak (nginx 1.27.3 or newer for
# "resolve" in upstream blocks). Place it on the nginx host, which must share
# the `reverseproxy` Docker network, adapt server_name/certs, then reload nginx.
#
# CRITICAL: `proxy_set_header Host $host;` is required.
#   - S3 SigV4 signs the Host header; a rewritten Host breaks every signature.
#   - The HTTP UI's CSRF check compares Origin/Referer against Host.
# Do NOT set `proxy_set_header Host birak:9400;` — that breaks both.
# $host drops the port. If clients reach nginx on a port other than 443, use
# `proxy_set_header Host $http_host;`: SigV4 signs the port as well.
#
# After the birak container is recreated, requests fail for up to the
# resolver's `valid` time (10 s below) until the new address is resolved.
#
# One nginx in front of several nodes cannot keep a node that is still
# catching up out of rotation: open-source nginx has no active health checks.
# For several nodes behind one address, use deploy/haproxy.birak.cfg.example,
# which routes by /readyz.

# Docker's embedded DNS. Re-resolving keeps nginx working after the birak
# container is recreated with a new address; without it nginx answers 502
# until it is reloaded.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream birak_s3 {
    zone birak_s3 64k;
    server birak:9200 resolve;
    # Reuse upstream connections: without keepalive every icon request opens
    # and closes a TCP connection.
    keepalive 64;
}

upstream birak_ui {
    zone birak_ui 64k;
    server birak:9400 resolve;
    keepalive 16;
}

# Optional brake on credential guessing; Birak itself does not throttle.
# limit_req_zone $binary_remote_addr zone=birak_auth:10m rate=20r/s;

# ---------- HTTP UI (web file browser) ----------
server {
    listen 443 ssl;
    http2 on;
    server_name files.example.com;                 # <-- your UI hostname

    ssl_certificate     /etc/letsencrypt/live/files.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/files.example.com/privkey.pem;

    client_max_body_size 0;                        # Birak enforces max_upload_bytes
    proxy_request_buffering off;                   # stream uploads, don't spool them
    proxy_buffering off;                           # stream downloads, don't spool them

    location / {
        # limit_req zone=birak_auth burst=40 nodelay;
        proxy_pass         http://birak_ui;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";          # keep upstream connections alive
        proxy_set_header   Host $host;             # REQUIRED (CSRF)
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# ---------- S3 API (path-style) ----------
# Clients must sign against this exact hostname, e.g.
#   aws --endpoint-url https://s3.example.com s3 ls
server {
    listen 443 ssl;
    http2 on;
    server_name s3.example.com;                    # <-- your S3 endpoint hostname

    ssl_certificate     /etc/letsencrypt/live/s3.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/s3.example.com/privkey.pem;

    client_max_body_size 0;                        # Birak enforces max_upload_bytes
    proxy_request_buffering off;                   # stream uploads, don't spool them
    # With buffering on, a slow client's 500 MiB APK is first written to
    # nginx's temporary directory: at APK egress rates that is terabytes of
    # disk writes a day on the proxy.
    proxy_buffering off;

    location / {
        proxy_pass         http://birak_s3;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";          # keep upstream connections alive
        proxy_set_header   Host $host;             # REQUIRED (SigV4)
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
