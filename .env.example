# Copy to .env and fill in. Birak refuses to start with an empty or half-set
# credential, and with any value that still starts with "changeme".

# Published image to pull. Every node of a cluster must run the same release.
BIRAK_IMAGE=solkin/birak:2.1.2

# Node identity: unique per node in a cluster, and never reused for a
# different data directory.
BIRAK_NODE_ID=node-1

# Shared secret for the peer API on :9100. Required: it protects every file.
BIRAK_CLUSTER_SECRET=changeme-cluster-secret

# Other nodes, comma-separated. Empty for a standalone node. Between sites use
# https:// (with BIRAK_TLS_CERT_FILE/KEY_FILE on every node) or a VPN.
BIRAK_PEERS=
# BIRAK_PEERS=https://node-2.example.net:9100,https://node-3.example.net:9100
# BIRAK_TLS_CERT_FILE=/tls/node.pem
# BIRAK_TLS_KEY_FILE=/tls/node.key
# BIRAK_PEER_CA_FILE=/tls/cluster-ca.pem

# Optional bearer token for Prometheus to scrape /metrics.
# BIRAK_METRICS_TOKEN=

# S3 gateway credentials (AWS Signature V4).
S3_ACCESS_KEY=changeme-access-key
S3_SECRET_KEY=changeme-secret-key

# HTTP UI credentials (basic auth).
HTTP_USERNAME=admin
HTTP_PASSWORD=changeme-password
